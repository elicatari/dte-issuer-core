# Demo only. Copy to `.env`. Never commit real secrets.

# Postgres: dueño (Flyway) y rol de runtime (dte_app). Distintos desde V1.
# dte_app: no superusuario, sin BYPASSRLS, no dueño de tablas.
POSTGRES_DB=dte_issuer
POSTGRES_USER=dte
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DTE_APP_USER=dte_app
DTE_APP_PASSWORD=change-me-app

# API en el host: runtime = dte_app; Flyway = dueño.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/dte_issuer
SPRING_DATASOURCE_USERNAME=dte_app
SPRING_DATASOURCE_PASSWORD=change-me-app
SPRING_FLYWAY_USER=dte
SPRING_FLYWAY_PASSWORD=change-me

# RabbitMQ
RABBITMQ_USER=dte
RABBITMQ_PASSWORD=change-me
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Keycloak (realm versionado en git; credenciales de demo)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_HTTP_PORT=8081
KEYCLOAK_REALM=dte
KEYCLOAK_CLIENT_ID=dte-demo

# Usuarios de demo (también en realm-export.json)
DEMO_USER_PASSWORD=change-me

# API (valores para correr en el host; Compose los pisa con hostnames internos)
API_PORT=8080
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=dte
SPRING_RABBITMQ_PASSWORD=change-me
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=http://localhost:8081/realms/dte
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWK_SET_URI=http://localhost:8081/realms/dte/protocol/openid-connect/certs